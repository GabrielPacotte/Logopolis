{
  "name": "logopolis",
  "version": "0.0.0",
  "private": true,
  "description": "Fondation technique de Logopolis — aucune fonctionnalité métier.",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19 <23",
    "npm": ">=10"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && node scripts/check-architecture.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:docs": "node scripts/check-docs.mjs",
    "check:agent-governance": "node scripts/check-agent-governance.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0",
    "vitest": "^4.1.12"
  }
}
