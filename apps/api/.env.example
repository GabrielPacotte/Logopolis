# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_NAME=Logopolis API
# Generate a local value with `node ace generate:key` after copying this file.
APP_KEY=
APP_URL=http://${HOST}:${PORT}
WEB_ORIGIN=http://localhost:3000

# Sender identity must use a verified Resend domain in production.
MAIL_FROM_ADDRESS=no-reply@logopolis.local
MAIL_FROM_NAME=Logopolis
# Production only; never commit a value. Tests capture messages in memory.
RESEND_API_KEY=

# Development only. Mailpit only accepts a local loopback host; CI starts an isolated Mailpit
# service solely for browser E2E tests. It is never used in production.
MAILPIT_HOST=127.0.0.1
MAILPIT_PORT=1025

DB_HOST=localhost
DB_PORT=5433
DB_USER=logopolis
DB_PASSWORD=logopolis
DB_DATABASE=logopolis

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
