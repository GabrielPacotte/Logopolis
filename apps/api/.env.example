# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_NAME=Logopolis API
# Generate a local value with `node ace generate:key` after copying this file.
APP_KEY=
APP_URL=http://${HOST}:${PORT}
WEB_ORIGIN=http://localhost:3000

# Local SMTP sink; no real delivery provider is used in development or tests.
MAIL_FROM_ADDRESS=no-reply@logopolis.local
MAIL_FROM_NAME=Logopolis
SMTP_HOST=localhost
SMTP_PORT=1025

DB_HOST=localhost
DB_PORT=5433
DB_USER=logopolis
DB_PASSWORD=logopolis
DB_DATABASE=logopolis

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
