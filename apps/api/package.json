{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    "./data": "./.adonisjs/client/data.d.ts",
    "./registry": "./.adonisjs/client/registry/index.ts"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "test:unit": "NODE_ENV=${NODE_ENV:-test} PORT=${PORT:-3334} HOST=${HOST:-127.0.0.1} LOG_LEVEL=${LOG_LEVEL:-error} APP_NAME=${APP_NAME:-Logopolis tests} APP_KEY=${APP_KEY:-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa} APP_URL=${APP_URL:-http://localhost:3334} WEB_ORIGIN=${WEB_ORIGIN:-http://localhost:3000} MAIL_FROM_ADDRESS=${MAIL_FROM_ADDRESS:-no-reply@logopolis.test} MAIL_FROM_NAME=${MAIL_FROM_NAME:-Logopolis} DB_HOST=${DB_HOST:-localhost} DB_PORT=${DB_PORT:-5433} DB_USER=${DB_USER:-logopolis} DB_PASSWORD=${DB_PASSWORD:-logopolis} DB_DATABASE=${DB_DATABASE:-logopolis} node ace test unit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test:integration": "WEB_ORIGIN=${WEB_ORIGIN:-http://localhost:3000} MAIL_FROM_ADDRESS=${MAIL_FROM_ADDRESS:-no-reply@logopolis.test} MAIL_FROM_NAME=${MAIL_FROM_NAME:-Logopolis} DB_PORT=${DB_PORT:-5433} node ace test functional",
    "test:integration:unready": "WEB_ORIGIN=${WEB_ORIGIN:-http://localhost:3000} MAIL_FROM_ADDRESS=${MAIL_FROM_ADDRESS:-no-reply@logopolis.test} MAIL_FROM_NAME=${MAIL_FROM_NAME:-Logopolis} EXPECT_DATABASE_READY=false DB_PORT=1 node ace test functional --files tests/functional/health.spec.ts",
    "migration:run": "node ace migration:run"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.5.2",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/luxon": "^3.7.5",
    "@types/node": "~26.6.2",
    "eslint": "^10.11.0",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/core": "^7.5.2",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/session": "^8.3.0",
    "@adonisjs/shield": "^9.0.0",
    "@japa/api-client": "^3.2.1",
    "@tuyau/core": "^1.2.2",
    "@vinejs/vine": "^4.4.0",
    "luxon": "^3.7.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.37.0"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "allowScripts": {
    "@swc/core": true,
    "esbuild": true,
    "fsevents": true
  },
  "prettier": "@adonisjs/prettier-config"
}
